---
import Layout from '../layouts/Layout.astro';
import Welcome from '../components/Welcome.astro';
import ContactoForm from '../components/ContactoForm.astro';
---

<Layout>
  <Welcome>
    <div class="contacto-flex">
      <div class="contacto-info">
        <h1>Contacto</h1>
        <p>Puedes contactarnos a través de los siguientes medios:</p>
        <ul>
          <li>Teléfono: +52 667 233 8091</li>
          <li>Email: solucionesticuliacan@gmail.com</li>
          <li>Dirección: Calle Juan José Ríos, 307 OTE Col. Miguel Alemán, Culiacán, Sinaloa</li>
          <li>Redes Sociales: Facebook, Instagram como SolucionesTI</li>
          <li>Horario de Atención: Lunes a Viernes de 8:00 AM a 6:00 PM, Sábado de 9:00 AM a 2:00 PM</li>
          <li>Hora Culiacán, Sinaloa: {new Date().toLocaleString('es-MX', { timeZone: 'America/Mazatlan' })}</li>
        </ul>
      </div>
      <div class="contacto-formulario">
        <h1>Cotizaciones o dudas:</h1>
        <ContactoForm />
      </div>
    </div>
  </Welcome>
</Layout>
