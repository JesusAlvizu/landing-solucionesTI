---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
import ServicioCard from '../components/servicio-card.astro';
---

<Layout>
    <Welcome>
        <h1>Necesitas un servicio de mantenimiento o reparación?</h1>
        <h3>Ofrecemos una amplia gama de servicios para satisfacer tus necesidades:</h3>
        <ul>
            <li>Limpieza interna y externa</li>
            <li>Formateo e instalación de sistemas operativos</li>
            <li>Actualización y reemplazo de componentes</li>
            <li>Reparación de fallas electrónicas</li>
            <li>Recuperación de datos</li>
        </ul>
        <br><br>
        <div class="servicios-individuales">
            <ServicioCard icon="/servicios/laptop.svg" nombre="Laptops" />
            <ServicioCard icon="/servicios/celular.svg" nombre="Celulares" />
            <ServicioCard icon="/servicios/consola.png" nombre="Consolas" />
            <ServicioCard icon="/servicios/desktop.svg" nombre="Desktop" />
            <ServicioCard icon="/servicios/tablet.svg" nombre="Tablets" />
        </div>
        <br><br>
        <h2>Trabajamos con las mejores marcas del mercado:</h2>
        <br><br>
        <div class="marcas">
            <img src="/marcas/hp.jpg" alt="HP" width="48" height="48" />
            <img src="/marcas/dell.webp" alt="Dell" width="90" height="48" />
            <img src="/marcas/lenovo.png" alt="Lenovo" width="90" height="48" />
            <img src="/marcas/asus.jpg" alt="Asus" width="90" height="48" />
            <img src="/marcas/acer.png" alt="Acer" width="90" height="48" />
            <img src="/marcas/nvidia.webp" alt="Nvidia" width="90" height="48" />
            <img src="/marcas/sony.webp" alt="Sony" width="90" height="48" />
            <img src="/marcas/samsung.jpg" alt="Samsung" width="90" height="48" />
            <img src="/marcas/ghia.png" alt="Apple" width="90" height="48" />
        </div>
    </Welcome>
</Layout>
